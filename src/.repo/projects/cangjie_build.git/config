[core]
	repositoryformatversion = 0
	filemode = true
[filter "lfs"]
	smudge = git-lfs smudge --skip -- %f
	process = git-lfs filter-process --skip
[remote "origin"]
	url = https://github.com/CangjieNext/cangjie_build
	review = https://github.com/CangjieNext/
	projectname = cangjie_build
	fetch = +refs/heads/*:refs/remotes/origin/*
[maintenance]
	auto = false
[gc]
	auto = 0
