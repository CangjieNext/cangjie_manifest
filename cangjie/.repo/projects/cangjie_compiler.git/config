[core]
	repositoryformatversion = 0
	filemode = true
[filter "lfs"]
	smudge = git-lfs smudge --skip -- %f
	process = git-lfs filter-process --skip
[remote "origin"]
	url = https://gitcode.com/Cangjie/cangjie_compiler
	review = https://gitcode.com/Cangjie/
	projectname = cangjie_compiler
	fetch = +refs/heads/*:refs/remotes/origin/*
[maintenance]
	auto = false
[gc]
	auto = 0
