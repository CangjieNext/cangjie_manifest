<?xml version="1.0" encoding="UTF-8"?>
<manifest>
  <!--
    Core Cangjie projects (group "default"): synced by `repo sync`.
    Optional projects (groups "llvm"/"vscode"/"plugins") carry the special
    group "notdefault", so they are only fetched when explicitly selected:

      repo init ... -g default,llvm        # full compiler build
      repo sync -g vscode                  # one-off add-on fetch

    Paths mirror the layout expected by cangjie_build docs
    ($WORKSPACE/<repo>), except llvm-project, which CMake expects at
    cangjie_compiler/third_party/llvm-project.
  -->

  <!-- ========== default: core 7 repos ========== -->
  <project name="cangjie_compiler"           path="cangjie_compiler"           groups="cangjie"/>
  <project name="cangjie_runtime"            path="cangjie_runtime"            groups="cangjie"/>
  <project name="cangjie_tools"              path="cangjie_tools"              groups="cangjie"/>
  <project name="cangjie_test"               path="cangjie_test"               groups="cangjie"/>
  <project name="cangjie_test_framework"     path="cangjie_test_framework"     groups="cangjie"/>
  <project name="cangjie_docs"               path="cangjie_docs"               groups="cangjie"/>
  <project name="cangjie_stdx"               path="cangjie_stdx"               groups="cangjie"/>
  <project name="cangjie_build"              path="cangjie_build"              groups="cangjie"/>
  <project name="cangjie_multiplatform_interop" path="cangjie_multiplatform_interop" groups="cangjie"/>
  <project name="cangjie_python_interop"     path="cangjie_python_interop"     groups="cangjie"/>
  <project name="cangjie_js_interop"         path="cangjie_js_interop"         groups="cangjie"/>

  <!-- ========== notdefault: llvm (pinned to upstream base commit) ========== -->
  <project name="llvm-project"
           path="cangjie_compiler/third_party/llvm-project"
           groups="notdefault,llvm"
           revision="5c68a1cb123161b54b72ce90e7975d95a8eaf2a4"
           upstream="main"/>

  <!-- ========== notdefault: IDE / editor tooling ========== -->
  <project name="vscode_cangjie"         path="vscode_cangjie"         groups="notdefault,vscode"/>
  <project name="cangjie_debug_adapter"  path="cangjie_debug_adapter"  groups="notdefault,plugins"/>
  <project name="cangjie_deveco_plugins" path="cangjie_deveco_plugins" groups="notdefault,plugins"/>
</manifest>
